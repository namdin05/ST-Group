{
  "feature": "FR-13",
  "featureName": "Dashboard",
  "source": "../test-cases/fr13.md",
  "datasets": {
    "mixed": [
      { "id": 101, "total_amount": 100000, "status": "delivered" },
      { "id": 102, "total_amount": 250000, "status": "delivered" },
      { "id": 103, "total_amount": 70000, "status": "pending" },
      { "id": 104, "total_amount": 80000, "status": "canceled" }
    ],
    "empty": [],
    "nonDelivered": [
      { "id": 201, "total_amount": 100000, "status": "pending" },
      { "id": 202, "total_amount": 200000, "status": "confirmed" },
      { "id": 203, "total_amount": 300000, "status": "shipping" },
      { "id": 204, "total_amount": 400000, "status": "canceled" }
    ],
    "largeDelivered": [{ "id": 301, "total_amount": 1000000000, "status": "delivered" }],
    "minimumDelivered": [{ "id": 401, "total_amount": 1, "status": "delivered" }],
    "allStatuses": [
      { "id": 501, "total_amount": 100000, "status": "delivered" },
      { "id": 502, "total_amount": 200000, "status": "pending" },
      { "id": 503, "total_amount": 300000, "status": "confirmed" },
      { "id": 504, "total_amount": 400000, "status": "shipping" },
      { "id": 505, "total_amount": 500000, "status": "canceled" }
    ]
  },
  "testCases": [
    {
      "id": "TC001",
      "layer": "UI",
      "datasetRef": "mixed",
      "expected": { "revenue": 350000, "orderCount": 4, "currency": "₫" }
    },
    {
      "id": "TC002",
      "layer": "UI",
      "datasetRef": "empty",
      "expected": { "revenue": 0, "orderCount": 0, "pageStable": true }
    },
    {
      "id": "TC003",
      "layer": "UI",
      "datasetRef": "nonDelivered",
      "expected": { "revenue": 0, "orderCount": 4 }
    },
    {
      "id": "TC004",
      "layer": "UI",
      "datasetRef": "largeDelivered",
      "expected": { "revenue": 1000000000, "formattedRevenue": "1.000.000.000 ₫", "orderCount": 1 }
    },
    {
      "id": "TC005",
      "layer": "API",
      "authFixture": "admin",
      "datasetRef": "mixed",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "status": 200, "bodyType": "array", "deliveredRevenue": 350000, "orderCount": 4 }
    },
    {
      "id": "TC006",
      "layer": "API",
      "request": { "method": "GET", "path": "/api/admin/orders", "authorization": null },
      "expected": { "status": 401, "adminDataReturned": false }
    },
    {
      "id": "TC007",
      "layer": "API",
      "authFixture": "admin",
      "datasetRef": "nonDelivered",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "status": 200, "deliveredRevenue": 0, "orderCount": 4 }
    },
    {
      "id": "TC008",
      "layer": "API",
      "authFixture": "admin",
      "datasetRef": "largeDelivered",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "status": 200, "deliveredRevenue": 1000000000, "precisionPreserved": true }
    },
    {
      "id": "TC009",
      "layer": "UI",
      "datasetRef": "minimumDelivered",
      "expected": { "revenue": 1, "orderCount": 1, "currency": "₫" }
    },
    {
      "id": "TC010",
      "layer": "UI",
      "datasetRef": "allStatuses",
      "expected": { "revenue": 100000, "orderCount": 5, "includedRevenueStatuses": ["delivered"] }
    },
    {
      "id": "TC011",
      "layer": "UI",
      "authFixture": null,
      "action": { "type": "navigate", "target": "admin-root" },
      "expected": { "loginVisible": true, "dashboardVisible": false, "metricsVisible": false }
    },
    {
      "id": "TC012",
      "layer": "API",
      "authFixture": "user",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "status": 403, "adminDataReturned": false }
    },
    {
      "id": "TC013",
      "layer": "API",
      "authFixture": "admin",
      "datasetRef": "empty",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "status": 200, "body": [], "deliveredRevenue": 0, "orderCount": 0 }
    },
    {
      "id": "TC014",
      "layer": "UI+API",
      "authFixture": "admin",
      "datasetRef": "mixed",
      "request": { "method": "GET", "path": "/api/admin/orders" },
      "expected": { "uiRevenueEqualsApiDeliveredSum": true, "uiOrderCountEqualsApiLength": true }
    }
  ]
}
