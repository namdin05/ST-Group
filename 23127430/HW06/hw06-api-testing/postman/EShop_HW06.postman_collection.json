  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const testCaseId = pm.iterationData.get(\"testCaseId\");",
          "const featureId = pm.iterationData.get(\"featureId\");",
          "if (testCaseId && featureId) {",
          "  const contextKey = featureId + \":\" + testCaseId + \":\" + pm.info.iteration;",
          "  if (pm.collectionVariables.get(\"contextKey\") !== contextKey) {",
          "    const studentId = pm.variables.replaceIn(\"{{studentId}}\");",
          "    const safeId = String(testCaseId).toLowerCase().replace(/[^a-z0-9]+/g, \".\");",
          "    const suffix = studentId + \".\" + Date.now() + \".\" + pm.info.iteration + \".\" + Math.random().toString(36).slice(2, 8);",
          "    const dynamicEmail = \"hw06.\" + safeId + \".\" + suffix + \"@example.test\";",
          "    pm.collectionVariables.set(\"contextKey\", contextKey);",
          "    pm.collectionVariables.set(\"caseSuffix\", suffix);",
          "    pm.environment.set(\"dynamicEmail\", dynamicEmail);",
          "    pm.collectionVariables.set(\"setupEmail\", dynamicEmail);",
          "    pm.collectionVariables.set(\"secondaryEmail\", \"hw06.secondary.\" + safeId + \".\" + suffix + \"@example.test\");",
          "    pm.environment.unset(\"userToken\");",
          "    pm.environment.unset(\"adminToken\");",
          "    pm.environment.unset(\"orderId\");",
          "    pm.collectionVariables.unset(\"userBToken\");",
          "    pm.collectionVariables.unset(\"baselineRevenue\");",
          "    pm.collectionVariables.unset(\"baselineOrderCount\");",
          "  }",
          "}",
          "const actualStudentId = pm.variables.replaceIn(\"{{studentId}}\");",
          "pm.request.headers.upsert({ key: \"X-Student-Id\", value: actualStudentId });",
          "console.log(\"X-Student-Id:\", actualStudentId);"
        ]
      }
    }
  ],
