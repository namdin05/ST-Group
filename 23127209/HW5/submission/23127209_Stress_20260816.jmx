            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate category list" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json instanceof List) || json.isEmpty()) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Categories response must be a non-empty array')
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
