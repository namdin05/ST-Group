          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Bind isolated performance user" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">int offset = ctx.getThreadGroup().getName().contains('Surge') ? 10 : 0
int userNumber = ctx.getThreadNum() + 1 + offset
vars.put('perf_email', String.format('perf%03d@eshop.test', userNumber))
vars.put('perf_password', 'Perf1234!')</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree />
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login must return HTTP 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Login must return HTTP 200</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree />
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate and correlate JWT" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json.token instanceof String) || json.token.isEmpty() || !(json.user?.id instanceof Number)) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Login response must contain JWT token and numeric user id')
} else {
  vars.put('token', json.token.toString())
  vars.put('user_id', json.user.id.toString())
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree />
          </hashTree>
