              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json.orderId instanceof Number)) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Checkout response must contain numeric orderId')
