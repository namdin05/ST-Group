          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Bind setup user" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="script">int userNumber = ctx.getThreadNum() + 1
vars.put('perf_email', String.format('perf%03d@eshop.test', userNumber))
vars.put('perf_password', 'Perf1234!')</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
